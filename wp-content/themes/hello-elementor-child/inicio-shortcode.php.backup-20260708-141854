<script>

// Agenda slider
var agendaIdx = 0;
var agendaTotal = 0;
function agendaNav(dir) {
  var el = document.getElementById('agendaTrack');
  if (!el) return;
  agendaTotal = el.children.length;
  agendaIdx = Math.max(0, Math.min(agendaTotal - 3, agendaIdx + dir));
  var cardW = el.children[0] ? el.children[0].offsetWidth + 16 : 300;
  el.style.transform = 'translateX(-' + (agendaIdx * cardW) + 'px)';
}
setInterval(function(){
  var el = document.getElementById('agendaTrack');
  if(!el) return;
  agendaTotal = el.children.length;
  if(agendaIdx >= agendaTotal - 3) agendaIdx = -1;
  agendaNav(1);
}, 4000);

// Notas slider
var notasIdx = 0;
function notasNav(dir) {
  var el = document.getElementById('notasTrack');
  if(!el) return;
  var total = el.children.length;
  notasIdx = Math.max(0, Math.min(total - 3, notasIdx + dir));
  var cardW = el.children[0] ? el.children[0].offsetWidth + 16 : 300;
  el.style.transform = 'translateX(-' + (notasIdx * cardW) + 'px)';
}
setInterval(function(){ 
  var el = document.getElementById('notasTrack');
  if(!el) return;
  if(notasIdx >= el.children.length - 3) notasIdx = -1;
  notasNav(1);
}, 5000);

// YT slider
var ytIdx = 0;
var ytTotal = 0;
function ytGo(n) {
  var el = document.getElementById('ytTrack');
  if(!el) return;
  ytTotal = el.children.length;
  ytIdx = (n + ytTotal) % ytTotal;
  el.style.transform = 'translateX(-' + (ytIdx * 100) + '%)';
  document.querySelectorAll('#ytDots .yt-dot').forEach(function(d,i){
    d.classList.toggle('active', i===ytIdx);
  });
}
function ytNav(d) { ytGo(ytIdx + d); }
setInterval(function(){ ytNav(1); }, 5000);

// Pub slider con dots
var pubIdx = {};
function pubInitDots(id) {
  var el = document.getElementById('pub-' + id);
  var dotsEl = document.getElementById('dots-' + id);
  if(!el || !dotsEl) return;
  var visible = 3;
  var total = el.children.length;
  var pages = Math.ceil(total / visible);
  dotsEl.innerHTML = '';
  for(var i=0; i<pages; i++) {
    var d = document.createElement('button');
    d.className = 'pub-dot' + (i===0?' active':'');
    d.setAttribute('data-page', i);
    d.setAttribute('data-id', id);
    d.onclick = function(){ pubGoPage(this.getAttribute('data-id'), parseInt(this.getAttribute('data-page'))); };
    dotsEl.appendChild(d);
  }
}
function pubUpdateDots(id) {
  var el = document.getElementById('pub-' + id);
  var dotsEl = document.getElementById('dots-' + id);
  if(!el || !dotsEl) return;
  var visible = 3;
  var page = Math.floor((pubIdx[id]||0) / visible);
  dotsEl.querySelectorAll('.pub-dot').forEach(function(d,i){ d.classList.toggle('active', i===page); });
}
function pubGoPage(id, page) {
  var el = document.getElementById('pub-' + id);
  if(!el) return;
  var visible = 3;
  pubIdx[id] = page * visible;
  var cardW = el.children[0] ? el.children[0].offsetWidth + 12 : 152;
  el.style.transform = 'translateX(-' + (pubIdx[id] * cardW) + 'px)';
  pubUpdateDots(id);
}
function pubNav(id, dir) {
  var el = document.getElementById('pub-' + id);
  if (!el) return;
  if (!pubIdx[id]) pubIdx[id] = 0;
  var visible = 3;
  var total = el.children.length;
  pubIdx[id] = Math.max(0, Math.min(total - visible, pubIdx[id] + dir));
  var cardW = el.children[0] ? el.children[0].offsetWidth + 12 : 152;
  el.style.transform = 'translateX(-' + (pubIdx[id] * cardW) + 'px)';
  pubUpdateDots(id);
}
// Init dots after load
window.addEventListener('load', function(){
  pubInitDots('libros');
  pubInitDots('revistas');
});
// Auto-scroll
setInterval(function(){
  var el = document.getElementById('pub-libros');
  if(!el) return;
  if(!pubIdx['libros']) pubIdx['libros'] = 0;
  if(pubIdx['libros'] >= el.children.length - 3) pubIdx['libros'] = -1;
  pubNav('libros', 1);
}, 3500);
setInterval(function(){
  var el = document.getElementById('pub-revistas');
  if(!el) return;
  if(!pubIdx['revistas']) pubIdx['revistas'] = 0;
  if(pubIdx['revistas'] >= el.children.length - 3) pubIdx['revistas'] = -1;
  pubNav('revistas', 1);
}, 4000);
</script>
